{
  "name": "rafi-case-files",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/check-build.mjs",
    "check:browser": "node scripts/browser-check.mjs",
    "check:effects": "node scripts/effects-check.mjs",
    "check:assembly": "node scripts/assembly-check.mjs",
    "check:navigation": "node scripts/navigation-check.mjs",
    "check:headline": "node scripts/headline-check.mjs",
    "check:lighthouse": "node scripts/lighthouse-check.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
